
(APPUNTI > { sogno del cacciatore > tombe di sinistra > dungeon tramite calici, le lanternine rosse vicino alle porte simboleggiano che c'è qualcuno con cui parlare dentro })

"https://bloodborne.wiki.fextralife.com/Caryll+Runes" > chiappa tutte queste rune >> queste mancano del tutto {
    "Beast's Embrace" > scofiggi questo "https://bloodborne.wiki.fextralife.com/Laurence%2C+the+First+Vicar##fex" (dlc)
    "Guidance" > sconfiggi l'uomo cavallo aborto
    "Hunter" > completa la quest di "Eileen the Crow" > "https://bloodborne.wiki.fextralife.com/Eileen+the+Crow"
    "Milkweed" > completa la quest di "Saint Adeline" > "https://bloodborne.wiki.fextralife.com/Saint+Adeline##fex"
}

oggetto chiave > "https://bloodborne.wiki.fextralife.com/Laurence's+Skull"

--------------------------------------------------------------------------------------------------------

sogno del cacciatore > dietro > continua per la strada finchè > non trovi un cancello >> ATTENZIONE > bloodborne ha il NG+ automatico > puoi bypassarlo tornando al falò (con l'oggetto) dopo aver battuto la "Moon Presence", ma dice che se ritorni sul "campo fiorito" ricomincia da solo >> finali > {
    1 > accetta l'offerta di Gehrman
    2 > rifiuta l'offerta di Gehrman
    3 > rifiuta l'offerta di Gehrman dopo aver consumato 3 terzi di cordone ombelicale
}

--------------------------------------------------------------------------------------------------------

"Lapide dell'incubo del cacciatore" > {
    "Pila di corpi sotterranea" > avanti > scale > su > sinistra > scale > su > {
        (sinistra > porta chiusa)
        destra > {
            (destra > porta chiusa)
            avanti > {
                (sinistra > ... > porta chiusa) >> "https://bloodborne.wiki.fextralife.com/Brador" > ammazza tutte le istanze
                (avanti > sinistra > porta chiuse)
            }
        }
    }
    "Edificio ricerche" > avanti > scale > su > {
        (sinistra > destra > avanti > porta > chiuso a chiave)
        scale a chiocciola > {
            (dalla forma sembrerebbe che possano essere girate > quando, eventualmente, ci riesci ripassale tutte)
            su > {
                (sinistra > si intravede un'oggetto sopra una piattaforma con un nemico simile ad uno spermatozzoo)
                (scale sulla sinistra > su > sinistra > sinistra > puoi calarti giù su un'altro set di scale > su > vicolo cieco che finisce in mezzo al nulla > probabilmente serve dopo che eventualmente giri le scale)
                scale sulla destra > su > sinistra > fondo > destra > porta > destra > scala a pioli > {
                    (mezzo > sulla destra > si intravede un'oggetto che pende)
                    (su > avanti > avanti > scale > su > destra > scale > su > porta > sinistra > sulla destra > si intravede un gran portone che probabilmente è accessibile quando, eventualmente, si ruotano le scale)
                }
            }
        }
        destra > porta > {
            (npc > vuole del fluido cerebrale > ("scuro e molliccio"))
            sinistra > ascensore > su > avanti > ascensore > {
                (mezzo > avanti > sinistra > ... > destra > scale > giù > sinistra > si vede un posto percorribile ma è troppo lontano per lanciarcisi)
                su > sinistra > avanti > scale > su > destra > scale > su > avanti > scale a pioli > su
            }
        }
    }
}